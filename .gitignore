# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# 部署包与临时文件
garden-deploy.tar.gz
*.tar.gz
*.tmp

# Local env files
.env
.env.*
!.env.example
!.env.acceptance.example

# Prisma generated client
prisma/generated

# 本地 AI 助手工作区（含测试密钥明文、验证脚本与日志，禁止入库）
.workbuddy/

# 项目根的 Claude 本地配置（含服务器地址与 root SSH 授权，禁止入库）
/.claude/

# 成熟度自动回写前生成的本地备份（运行时产物）
content/vault/.maturity-backup/

# vault 内的本地工具与工作区目录（Obsidian 插件 / AI 会话 / 同步工具，不入库）
# 注意：content/vault 是指向本地笔记根（E:\Vault）的 junction，vault 根级同样要排除
# 同步工具自身与两个双击启动脚本，否则它们会被 git 跟踪/误入库
content/vault/.sync/
content/vault/*.bat
content/vault/KnowledgeBase/.obsidian/
content/vault/KnowledgeBase/.claudian/
content/vault/KnowledgeBase/.sync/
content/vault/KnowledgeBase/_sync/

# 未展开环境变量被当成路径创建出来的字面量目录（如 %SystemDrive%/ProgramData/...）
%SystemDrive%/
%USERPROFILE%/
%TEMP%/
