# ============================================================
# 环境变量样例 —— 复制为 .env 后填入真实值（.env 已被 git 忽略，禁止提交）
# ============================================================

# ---- 应用 ----
# 生产数据库连接串（本地开发同样使用）
DATABASE_URL="postgresql://<用户>:<密码>@localhost:5432/<库名>?schema=public"
# 服务端口（默认 3000）
PORT=3000
# 会话签名密钥（可用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成）
AUTH_SECRET=<32 字节十六进制>
# ---- 初始管理员种子密钥 ----
# 初始管理员种子密钥 —— **必填于空库首次启动**（仅密钥表为空时播种一次；
# 源码不含默认值，缺失时应用拒绝启动）。存量部署无需配置。
SEED_ADMIN_KEY=<自定义初始 root 密钥>

# ---- AI 增强（标签 / 领域判定的 LLM）----
# ⚠️ 正常情况下**不需要在这里配置**：管理员可在「管理后台 → AI 增强设置」里
#    直接开关增强、填写 API 地址 / 模型 / 密钥，保存即生效、无需重启。
#    那些设置存在数据库里，密钥以 AES-256-GCM 加密（加密密钥由 AUTH_SECRET 派生）。
#
# 下面这几个变量仅用于**无界面的场景**（CI、容器编排里预置、或不想把配置放进库）：
#   · 只有当数据库里**没有**设置行时才会被采用（界面一旦保存过就以界面为准）；
#   · 唯一例外：界面里没存密钥时会回退用 TAG_LLM_API_KEY（避免「保存过一次表单就把密钥弄丢」）。
# TAG_LLM_ENABLED=1
# TAG_LLM_BASE_URL=https://api.deepseek.com/v1
# TAG_LLM_MODEL=deepseek-chat
# TAG_LLM_API_KEY=sk-...
# 单次调用的超时（毫秒，默认 20000）——这个只认环境变量，不在界面上
# TAG_LLM_TIMEOUT_MS=20000
# 关闭「导入后自动排队生成标签建议」（默认开启）
# TAG_SUGGEST_AUTO=0

# ---- docker-compose.yml 的 postgres 服务 ----
POSTGRES_USER=garden_user
POSTGRES_PASSWORD=<强密码>
POSTGRES_DB=garden_db

# ---- docker-compose.local.yml（应用容器连本机数据库）----
# 与 DATABASE_URL 中的密码保持一致
DB_PASSWORD=<本机数据库密码>

# ---- PM2（可选）----
# PM2_INSTANCES=1
# PM2_MAX_MEMORY=450M
