# ============================================================
# 环境变量样例 —— 复制为 .env 后填入真实值（.env 已被 git 忽略，禁止提交）
# ============================================================

# ---- 应用 ----
# 生产数据库连接串（本地开发同样使用）
DATABASE_URL="postgresql://<用户>:<密码>@localhost:5432/<库名>?schema=public"
# 服务端口（默认 3000）
PORT=3000
# 会话签名密钥（可用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成）
AUTH_SECRET=<32 字节十六进制>
# 初始管理员种子密钥 —— **必填于空库首次启动**（仅密钥表为空时播种一次；
# 源码不含默认值，缺失时应用拒绝启动）。存量部署无需配置。
SEED_ADMIN_KEY=<自定义初始 root 密钥>

# ---- docker-compose.yml 的 postgres 服务 ----
POSTGRES_USER=garden_user
POSTGRES_PASSWORD=<强密码>
POSTGRES_DB=garden_db

# ---- docker-compose.local.yml（应用容器连本机数据库）----
# 与 DATABASE_URL 中的密码保持一致
DB_PASSWORD=<本机数据库密码>

# ---- PM2（可选）----
# PM2_INSTANCES=1
# PM2_MAX_MEMORY=450M
